# =============================================================
# Cubifai Dental CRM Dashboard - Environment Configuration
# =============================================================

# Server Port (Defaults to 8000 if omitted)
PORT=8000

# VPS Gateway API Endpoint (Relays tenant auth, bookings, stats)
GATEWAY_API_URL=https://gateway.cubifai.com

# JWT Session Cookie Signing Secret (Generate a strong random string)
SESSION_SECRET=super-secret-cubifai-session-key-2026

# Node Environment ('production' enforces HTTPS secure cookies)
NODE_ENV=production
